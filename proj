/* ──────────────────────────────────────────────
   1. CSS CUSTOM PROPERTIES (Design System)
────────────────────────────────────────────── */
:root {
  /* Colors — Client Site */
  
  --primary:       #1C0770;   /* main gym identity */
  --accent:        #e0083a;   /* energy / action */
  --accent-2:      #3a7cff;   /* highlight / neon blue */
  --accent-hover:  #e01e55;

  --bg:            #07051f;
  --bg-alt:        #0e0b2f;

  --text:          #f1f2ff;
  --text-muted:    #a4a6d3;

  --card:          #141238;
  --card-hover:    #1b1950;

  --border:        #25236a;
  --border-light:  #3431a0;

  --white:         #ffffff;
  --black:         #000000;

  /* Colors — Admin Site */
  --admin-bg:            #f4f6fb;
  --admin-sidebar:       #0b017a;
  --admin-sidebar-hover: #1406a8;

  --admin-text:          #2a2f45;
  --admin-card:          #ffffff;

  --admin-border:        #e2e6f3;

  --admin-accent:        #3a6cff;   /* brand action */
  --admin-success:       #22c55e;
  --admin-danger:        #ef4444;
  --admin-warning:       #f59e0b;
  /* Typography */
  --font-heading:  'Oswald', sans-serif;
  --font-body:     'Roboto', sans-serif;

  --fs-xs:    0.75rem;    /* 12px */
  --fs-sm:    0.875rem;   /* 14px */
  --fs-base:  1rem;       /* 16px */
  --fs-md:    1.125rem;   /* 18px */
  --fs-lg:    1.25rem;    /* 20px */
  --fs-xl:    1.5rem;     /* 24px */
  --fs-2xl:   2rem;       /* 32px */
  --fs-3xl:   2.5rem;     /* 40px */
  --fs-4xl:   3.5rem;     /* 56px */
  --fs-hero:  5rem;       /* 80px */

  /* Spacing Scale (8px base) */
  --sp-1:  0.5rem;    /* 8px  */
  --sp-2:  1rem;      /* 16px */
  --sp-3:  1.5rem;    /* 24px */
  --sp-4:  2rem;      /* 32px */
  --sp-5:  3rem;      /* 48px */
  --sp-6:  4rem;      /* 64px */
  --sp-7:  5rem;      /* 80px */

  /* Layout */
  --max-width:        1200px;
  --navbar-height:    70px;
  --sidebar-width:    260px;
  --border-radius:    8px;
  --border-radius-lg: 16px;
  --border-radius-xl: 24px;
  --border-radius-full: 9999px;

  /* Shadows */
  --shadow-sm:  0 2px 8px rgba(0,0,0,0.3);
  --shadow-md:  0 4px 20px rgba(0,0,0,0.4);
  --shadow-lg:  0 8px 40px rgba(0,0,0,0.5);
  --shadow-accent: 0 4px 20px rgba(233,69,96,0.4);

  /* Transitions */
  --transition: all 0.3s ease;
  --transition-fast: all 0.15s ease;
}

/* ──────────────────────────────────────────────
   2. CSS RESET & BASE STYLES
────────────────────────────────────────────── */
*, *::before, *::after {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

html {
  scroll-behavior: smooth;
  font-size: 16px;
}

body {
  font-family: var(--font-body);
  font-size: var(--fs-base);
  background-color: var(--bg);
  color: var(--text);
  line-height: 1.6;
  min-height: 100vh;
}

img {
  max-width: 100%;
  height: auto;
  display: block;
}

a {
  color: var(--accent);
  text-decoration: none;
  transition: var(--transition-fast);
}

a:hover {
  color: var(--accent-hover);
}

#namelogo:hover{
  color: var(--text);
}

ul {
  list-style: none;
}

h1, h2, h3, h4, h5, h6 {
  font-family: var(--font-heading);
  font-weight: 700;
  line-height: 1.2;
  color: var(--white);
  letter-spacing: 0.02em;
}

h1 { font-size: var(--fs-3xl); }
h2 { font-size: var(--fs-2xl); }
h3 { font-size: var(--fs-xl); }
h4 { font-size: var(--fs-lg); }

p {
  margin-bottom: var(--sp-2);
  color: var(--text);
}

.sr-only {
  position: absolute;
  width: 1px;
  height: 1px;
  padding: 0;
  margin: -1px;
  overflow: hidden;
  clip: rect(0,0,0,0);
  white-space: nowrap;
  border-width: 0;
}

/* ──────────────────────────────────────────────
   3. LAYOUT UTILITIES
────────────────────────────────────────────── */
.container {
  width: 100%;
  max-width: var(--max-width);
  margin: 0 auto;
  padding: 0 var(--sp-2);
}

.section {
  padding: var(--sp-6) 0;
}

.section-title {
  font-size: var(--fs-2xl);
  text-align: center;
  margin-bottom: var(--sp-2);
  position: relative;
  padding-bottom: var(--sp-2);
}

.section-title::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 60px;
  height: 3px;
  background: var(--accent);
  border-radius: var(--border-radius-full);
}

.section-subtitle {
  text-align: center;
  color: var(--text-muted);
  font-size: var(--fs-md);
  margin-bottom: var(--sp-5);
}

/* 3-column grid → 2 tablet → 1 mobile */
.cards-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: var(--sp-3);
}

.plans-grid {
  display: flex;
  gap: var(--sp-3);
  justify-content: center;
  flex-wrap: wrap;
  align-items: stretch;
}

/* ──────────────────────────────────────────────
   4. NAVIGATION / HEADER
────────────────────────────────────────────── */
.site-header {
  position: sticky;
  top: 0;
  z-index: 1000;
  background: rgba(15, 15, 26, 0.97);
  backdrop-filter: blur(10px);
  border-bottom: 1px solid var(--border);
  box-shadow: var(--shadow-sm);
}

.navbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: var(--navbar-height);
  max-width: var(--max-width);
  margin: 0 auto;
  padding: 0 var(--sp-2);
}

.nav-logo {
  font-family: var(--font-heading);
  font-size: var(--fs-xl);
  font-weight: 700;
  color: var(--white);
  letter-spacing: 0.05em;
  display: flex;
  align-items: center;
  gap: var(--sp-1);
}


.logo-icon {
  color: var(--accent);
  font-size: 2.3em;
  position: relative;
  top: -5px;
}

#footer-logo {
  color: var(--accent);
  font-size: 2.3em;
  position: relative;
  top: +5px
}

.nav-links {
  display: flex;
  align-items: center;
  gap: var(--sp-1);
}

.nav-link {
  color: var(--text);
  font-family: var(--font-heading);
  font-size: var(--fs-sm);
  font-weight: 600;
  gap: 0.08em;
  text-transform: uppercase;
  padding: var(--sp-1) var(--sp-2);
  border-radius: var(--border-radius);
  position: relative;
  transition: var(--transition);
}

.nav-link::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 0;
  height: 2px;
  background: var(--accent);
  transition: width 0.3s ease;
  border-radius: var(--border-radius-full);
}

.nav-link:hover,
.nav-link.active {
  color: var(--accent);
}

.nav-link:hover::after,
.nav-link.active::after {
  width: 80%;
}

.nav-admin-btn {
  background: var(--accent);
  color: var(--white) !important;
  border-radius: var(--border-radius-full);
  padding: 0.4rem 1.2rem;
}

.nav-admin-btn:hover {
  background: var(--accent-hover);
  color: var(--white) !important;
}

.nav-admin-btn::after { display: none; }

/* Hamburger (mobile) */
.hamburger {
  display: none;
  flex-direction: column;
  gap: 5px;
  background: none;
  border: none;
  cursor: pointer;
  padding: var(--sp-1);
}

.hamburger span {
  display: block;
  width: 24px;
  height: 2px;
  background: var(--white);
  border-radius: 2px;
  transition: var(--transition);
}

/* ──────────────────────────────────────────────
   5. BUTTONS
────────────────────────────────────────────── */
.btn {
  display: inline-block;
  font-family: var(--font-heading);
  font-size: var(--fs-sm);
  font-weight: 600;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  padding: 0.6rem 1.6rem;
  border-radius: var(--border-radius-full);
  border: 2px solid transparent;
  cursor: pointer;
  transition: var(--transition);
  text-align: center;
  min-height: 44px;
  line-height: 1;
  display: inline-flex;
  align-items: center;
  justify-content: center;
}

.btn-lg { padding: 0.85rem 2.5rem; font-size: var(--fs-base); }
.btn-sm { padding: 0.4rem 1rem; font-size: var(--fs-xs); min-height: 36px; }
.btn-xs { padding: 0.25rem 0.75rem; font-size: var(--fs-xs); min-height: 30px; }
.btn-full { width: 100%; }

.btn-accent {
  background: var(--accent);
  color: var(--white);
  border-color: var(--accent);
  box-shadow: var(--shadow-accent);
}
.btn-accent:hover {
  background: var(--accent-hover);
  border-color: var(--accent-hover);
  transform: translateY(-2px);
  box-shadow: 0 6px 24px rgba(233,69,96,0.5);
  color: var(--white);
}

.btn-outline {
  background: transparent;
  color: var(--text);
  border-color: var(--border-light);
}
.btn-outline:hover {
  border-color: var(--accent);
  color: var(--accent);
  transform: translateY(-2px);
}

.btn-gold {
  background: transparent;
  color: var(--text);
  border-color: var(--border-light);
  font-weight: 700;
}
.btn-gold:hover {
  border-color: var(--accent);
  color: var(--accent);
  transform: translateY(-2px);
}

/* ──────────────────────────────────────────────
   6. HERO SECTION
────────────────────────────────────────────── */
.hero {
  position: relative;
  min-height: calc(100vh - var(--navbar-height));
  display: flex;
  align-items: center;
  justify-content: center;
