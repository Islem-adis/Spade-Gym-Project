/* ──────────────────────────────────────────────
   8. CARDS
────────────────────────────────────────────── */
.card {
  background: var(--card);
  border: 1px solid var(--border);
  border-radius: var(--border-radius-lg);
  overflow: hidden;
  transition: var(--transition);
}

.card:hover {
